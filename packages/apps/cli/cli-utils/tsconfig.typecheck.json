{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@lumpcode/cli-utils": ["./src/index.ts"],
      "@lumpcode/cli-types": ["../cli-types/src/index.ts"],
      "@lumpcode/core": ["../../../core/src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*.types.test.ts",
    "src/presets/**/*.ts",
    "src/index.ts",
    "src/utils.ts",
    "../cli-types/src/**/*.ts",
    "../src/types/**/*.ts",
    "../../../core/src/types/**/*.ts",
    "../../../core/src/usages/**/*.ts",
    "../../../core/src/index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/unit.test.ts",
    "../src/**/*.unit.test.ts",
    "../../../core/src/**/*.unit.test.ts"
  ]
}
