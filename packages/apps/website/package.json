{
  "name": "@lumpcode/website",
  "private": true,
  "type": "module",
  "description": "Public website for Lumpcode",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "deploy": "nuxt generate && npx wrangler pages deploy .output/public --project-name lumpcode --branch main --commit-dirty=true",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --config vitest.config.ts",
    "brand": "node brand/render.mjs"
  },
  "dependencies": {
    "marked": "^18.0.11",
    "nuxt": "^4.5.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  }
}
