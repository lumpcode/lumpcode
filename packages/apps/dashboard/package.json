{
  "name": "@lumpcode/dashboard",
  "private": true,
  "version": "0.0.0",
  "description": "Read-only worker dashboard served by lumpcode dashboard",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/build.mjs",
    "test": "vitest run --config vitest.config.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@lumpcode/core": "*"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "typescript": "^5.7.2"
  }
}
