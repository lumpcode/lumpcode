{
  "name": "lumpcode-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:all": "npm run build -w=@lumpcode/core && npm run build -w=@lumpcode/cli && npm run build -w=@lumpcode/cli-types && npm run build -w=@lumpcode/cli-utils && npm run build -w=@lumpcode/recipes",
    "azure-daemon-vm": "node scripts/azure-daemon-vm/deploy.mjs",
    "hetzner-daemon-vm": "node scripts/hetzner-daemon-vm/deploy.mjs",
    "publish-skills": "node scripts/publish-skills.mjs",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "website": "npm run dev -w=@lumpcode/website",
    "website:deploy": "npm run deploy -w=@lumpcode/website"
  },
  "workspaces": [
    "packages/core",
    "packages/recipes",
    "packages/apps/cli/cli-types",
    "packages/apps/cli/cli-utils",
    "packages/apps/*",
    "packages/libs/*"
  ],
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^24.13.3",
    "@vitest/ui": "^3.2.4",
    "fallow": "^3.14.0",
    "js-yaml": "^5.0.0",
    "rollup": "^4.52.5",
    "type-fest": "^5.1.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.4"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.27",
    "@lumpcode/cli-types": "*",
    "@lumpcode/cli-utils": "*",
    "@lumpcode/recipes": "*"
  },
  "allowScripts": {
    "esbuild@0.25.11": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
